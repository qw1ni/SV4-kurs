# Подключение к локальному PostgreSQL
# Замените USER, PASSWORD, DBNAME на ваши значения (создайте БД через pgAdmin или psql)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/staffing_db?schema=public"

# HTTP-сервер
PORT=4000
NODE_ENV=development

# CORS (где работает фронтенд)
CLIENT_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
