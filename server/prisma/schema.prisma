// Prisma schema для онлайн-платформы управления штатным расписанием.
// 9 связанных таблиц в 3НФ.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Пользователи (учётные записи для входа в систему)
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole   @default(EMPLOYEE)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  employee     Employee?
  auditLogs    AuditLog[]

  @@map("users")
}

enum UserRole {
  HR_MANAGER
  EMPLOYEE
}

// ─────────────────────────────────────────────────────────────────────────────
// Подразделения (иерархическая структура организации)
// ─────────────────────────────────────────────────────────────────────────────
model Department {
  id          Int          @id @default(autoincrement())
  name        String
  code        String       @unique
  description String?
  parentId    Int?         @map("parent_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentHierarchy")
  staffUnits  StaffUnit[]

  @@index([parentId])
  @@map("departments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Должности (справочник должностей с квалификационными требованиями)
// ─────────────────────────────────────────────────────────────────────────────
model Position {
  id                       Int          @id @default(autoincrement())
  title                    String
  code                     String       @unique
  description              String?
  qualificationRequirements String?     @map("qualification_requirements")
  category                 String?
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  staffUnits               StaffUnit[]
  salaryHistory            SalaryRecord[]

  @@map("positions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Сотрудники (персональные данные)
// ─────────────────────────────────────────────────────────────────────────────
model Employee {
  id            Int            @id @default(autoincrement())
  userId        Int?           @unique @map("user_id")
  firstName     String         @map("first_name")
  lastName      String         @map("last_name")
  middleName    String?        @map("middle_name")
  birthDate     DateTime?      @map("birth_date") @db.Date
  gender        Gender?
  phone         String?
  personalEmail String?        @map("personal_email")
  address       String?
  hireDate      DateTime       @map("hire_date") @db.Date
  dismissalDate DateTime?      @map("dismissal_date") @db.Date
  status        EmployeeStatus @default(ACTIVE)
  photoUrl      String?        @map("photo_url")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  staffUnits    StaffUnit[]
  leaveRequests LeaveRequest[]
  documents     EmployeeDocument[]

  @@index([status])
  @@index([lastName])
  @@map("employees")
}

enum Gender {
  MALE
  FEMALE
}

enum EmployeeStatus {
  ACTIVE
  VACATION
  SICK_LEAVE
  DISMISSED
}

// ─────────────────────────────────────────────────────────────────────────────
// Штатные единицы (центральная сущность штатного расписания)
// Связывает подразделение + должность + (опционально) сотрудника.
// ─────────────────────────────────────────────────────────────────────────────
model StaffUnit {
  id            Int             @id @default(autoincrement())
  departmentId  Int             @map("department_id")
  positionId    Int             @map("position_id")
  employeeId    Int?            @map("employee_id")
  salary        Decimal         @db.Decimal(12, 2)
  rate          Decimal         @db.Decimal(4, 2) // ставка: 0.25 / 0.5 / 1.00
  workSchedule  WorkSchedule    @default(FULL_TIME) @map("work_schedule")
  status        StaffUnitStatus @default(VACANT)
  openedDate    DateTime        @map("opened_date") @db.Date
  closedDate    DateTime?       @map("closed_date") @db.Date
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  department    Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  position      Position        @relation(fields: [positionId], references: [id], onDelete: Restrict)
  employee      Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([positionId])
  @@index([employeeId])
  @@index([status])
  @@map("staff_units")
}

enum WorkSchedule {
  FULL_TIME
  PART_TIME
  FLEXIBLE
  REMOTE
  SHIFT
}

enum StaffUnitStatus {
  OCCUPIED  // занята сотрудником
  VACANT    // открытая вакансия
  RESERVED  // зарезервирована (например, на время декрета)
  CLOSED    // закрыта (исключена из штатного расписания)
}

// ─────────────────────────────────────────────────────────────────────────────
// История окладов по должностям (нормализация: оклад зависит от должности+даты)
// ─────────────────────────────────────────────────────────────────────────────
model SalaryRecord {
  id            Int       @id @default(autoincrement())
  positionId    Int       @map("position_id")
  baseSalary    Decimal   @map("base_salary") @db.Decimal(12, 2)
  allowances    Decimal   @default(0) @db.Decimal(12, 2)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  reason        String?
  createdAt     DateTime  @default(now()) @map("created_at")

  position      Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId])
  @@map("salary_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// Заявки сотрудников (отпуск, больничный, перевод)
// ─────────────────────────────────────────────────────────────────────────────
model LeaveRequest {
  id          Int                @id @default(autoincrement())
  employeeId  Int                @map("employee_id")
  type        LeaveType
  startDate   DateTime           @map("start_date") @db.Date
  endDate     DateTime           @map("end_date") @db.Date
  status      LeaveRequestStatus @default(PENDING)
  reason      String?
  decision    String?
  decidedAt   DateTime?          @map("decided_at")
  decidedById Int?               @map("decided_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

enum LeaveType {
  ANNUAL      // ежегодный отпуск
  UNPAID      // без сохранения зарплаты
  SICK        // больничный
  STUDY       // учебный
  MATERNITY   // декретный
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

// ─────────────────────────────────────────────────────────────────────────────
// Документы сотрудников (паспорт, СНИЛС, диплом и т.д.)
// ─────────────────────────────────────────────────────────────────────────────
model EmployeeDocument {
  id         Int          @id @default(autoincrement())
  employeeId Int          @map("employee_id")
  type       DocumentType
  number     String
  issueDate  DateTime?    @map("issue_date") @db.Date
  issuedBy   String?      @map("issued_by")
  notes      String?
  createdAt  DateTime     @default(now()) @map("created_at")

  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_documents")
}

enum DocumentType {
  PASSPORT
  SNILS
  INN
  DIPLOMA
  WORK_BOOK
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────────
// Журнал действий (аудит)
// ─────────────────────────────────────────────────────────────────────────────
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   // CREATE / UPDATE / DELETE / LOGIN
  entity    String   // employees / departments / staff_units / ...
  entityId  Int?     @map("entity_id")
  details   String?  // JSON-сериализация изменений
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}
