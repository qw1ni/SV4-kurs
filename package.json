{
  "name": "staffing-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Онлайн-платформа для управления штатным расписанием организации",
  "author": "Петров М. А.",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server:install": "npm install --workspace=server",
    "server:dev": "npm run dev --workspace=server",
    "server:migrate": "npm run prisma:migrate --workspace=server",
    "server:seed": "npm run prisma:seed --workspace=server",
    "client:install": "npm install --workspace=client",
    "client:dev": "npm run dev --workspace=client",
    "client:build": "npm run build --workspace=client",
    "install:all": "npm install",
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm run server:dev\" \"npm run client:dev\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
